      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:starting_compound:nk]' type='palette'>
            <map to='#59a14f'>
              <bucket>&quot;Intermediate&quot;</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>&quot;Hard&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Soft&quot;</bucket>
            </map>
            <map to='#edc948'>
              <bucket>&quot;Medium&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:dnf_reason:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>%null%</bucket>
            </map>
            <map to='#59a14f'>
              <bucket>&quot;Gearbox&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;Engine&quot;</bucket>
            </map>
            <map to='#b07aa1'>
              <bucket>&quot;Mechanical&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Collision&quot;</bucket>
            </map>
            <map to='#edc948'>
              <bucket>&quot;Hydraulics&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Brake failure&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:team:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;Alpine&quot;</bucket>
            </map>
            <map to='#59a14f'>
              <bucket>&quot;Kick Sauber&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;Haas&quot;</bucket>
            </map>
            <map to='#9c755f'>
              <bucket>&quot;Red Bull Racing&quot;</bucket>
            </map>
            <map to='#b07aa1'>
              <bucket>&quot;Mercedes&quot;</bucket>
            </map>
            <map to='#bab0ac'>
